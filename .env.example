# Postgres connection string from Neon (Vercel Marketplace sets DATABASE_URL for you).
# Leave empty for local development: the app then uses an embedded Postgres in .data/pglite.
DATABASE_URL=

# Random secret for login sessions: generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Public URL of the app, e.g. https://gestionale-flussi.vercel.app (http://localhost:3000 locally).
BETTER_AUTH_URL=http://localhost:3000
